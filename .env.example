# ==============================================================================
# ASTRA – Astronaut Health Intelligence System
# Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Optional Upstream FastAPI Backend Service
# If deployed alongside the Python backend (e.g. in docker-compose or Kubernetes),
# set this to route CDSS analysis and ground telemetry through to FastAPI:
BACKEND_URL=

# Optional Supabase Database & Realtime (for backend synchronization)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ENABLED=false

# Ground Telemetry Gateway Notification Emails
GROUND_TEAM_EMAIL=
FLIGHT_SURGEON_EMAIL=
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_API_KEY=
