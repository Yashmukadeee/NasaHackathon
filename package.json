{
  "name": "mission-vitals",
  "version": "1.0.0",
  "description": "Offline astronaut health self-monitoring (hackathon project)",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node -e \"console.log('Build OK - static assets verified')\"",
    "start": "node server.mjs",
    "serve": "node server.mjs",
    "data": "python3 simulator/simulate.py --all",
    "test": "node --test tests/*.test.mjs",
    "eval": "node eval/evaluate.mjs",
    "backend": "python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend",
    "pytest": "python3 -m pytest backend/app/tests -q"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
