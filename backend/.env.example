# Relational Database
DATABASE_URL=sqlite+aiosqlite:///./astra.db
FASTAPI_PORT=8000
FRONTEND_ORIGIN=http://localhost:8080

# Supabase PostgreSQL & Realtime Configuration
# Replace with your own project values. Never commit real keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ENABLED=true

# Ground Communication Gateway
GROUND_TEAM_EMAIL=
FLIGHT_SURGEON_EMAIL=
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_API_KEY=

# API authentication for /api/v1/analysis/assess.
# Empty = authentication disabled. Set a value in your local .env to enable it.
FASTAPI_API_KEY=

# System Settings
REQUEST_TIMEOUT_SECONDS=30
RESEARCH_REFRESH_INTERVAL_HOURS=24
PROTOTYPE_WARNING=true